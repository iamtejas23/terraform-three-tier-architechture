# ── Terraform state — NEVER commit ───────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
tfplan
*.tfplan
crash.log
crash.*.log

# ── Secrets — NEVER commit ────────────────────────────────────────────────────
# Do NOT add terraform.tfvars here — they contain config, not secrets.
# DB passwords are auto-generated by random_password and live only in Secrets Manager.
# If you add real secrets to a .tfvars file, name it *.secret.tfvars or *.local.tfvars.
*.secret.tfvars
*.local.tfvars
secrets.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.env
venv/
.venv/

# ── Local build artefacts ─────────────────────────────────────────────────────
*.tar.gz
